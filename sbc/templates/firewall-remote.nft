# Routed, not masqueraded. PBX needs a return route to the local tunnel IP.
table inet sbc_guard {
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "wg-sbc" ip saddr @@local_tunnel_ip@@ ip daddr @@pbx_ip@@ udp dport @@pbx_sip_port@@ accept
    iifname "wg-sbc" ip saddr @@local_tunnel_ip@@ ip daddr @@pbx_ip@@ udp dport @@pbx_rtp_min@@-@@pbx_rtp_max@@ accept
    oifname "wg-sbc" ip saddr @@pbx_ip@@ ip daddr @@local_tunnel_ip@@ udp dport @@sbc_sip_port@@ accept
    oifname "wg-sbc" ip saddr @@pbx_ip@@ ip daddr @@local_tunnel_ip@@ udp dport @@sbc_rtp_min@@-@@sbc_rtp_max@@ accept
    iifname "wg-sbc" drop
    oifname "wg-sbc" drop
  }
  chain input {
    type filter hook input priority -10; policy accept;
    iifname "wg-sbc" drop
  }
}
